# ============================================
# KickoffXI — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask secret key — MUST be a long, random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Flask configuration: 'development' or 'production'
FLASK_CONFIG=development

# ============================================
# Gmail SMTP Configuration
# ============================================
# Required for the forgot-password OTP email flow.
#
# PRECONDITION: You must have 2-Step Verification enabled on your
# Google account, then generate a 16-character App Password at:
#   https://myaccount.google.com/apppasswords
# Use that App Password here — NOT your normal Google account password.
#
# Note: If Google displays your App Password with spaces (e.g. "abcd efgh ijkl mnop"),
# remove the spaces: "abcdefghijklmnop".

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=sr300rollins@gmail.com
MAIL_PASSWORD=dfcfqvydexukfswp
