# ============================================
# KickoffXI — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask secret key — MUST be a long, random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Flask configuration: 'development' or 'production'
FLASK_CONFIG=development

# Optional base URL for generating absolute links (e.g. password reset)
APP_BASE_URL=http://localhost:5000

# ============================================
# Firebase Configuration
# ============================================
# Path to service account JSON key file (outside repository) OR raw JSON string:
# Option A: Path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json
# Option B: Raw JSON string or path in FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web API Key (from Firebase Console -> Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Session cookie settings
AUTH_SESSION_COOKIE_NAME=kxi_session
AUTH_REMEMBER_DAYS=14
AUTH_SHORT_SESSION_HOURS=12

# Optional Firebase Emulator configuration (for offline testing)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ============================================
# Gmail SMTP Configuration
# ============================================
# Required for the password reset email flow.
#
# PRECONDITION: You must have 2-Step Verification enabled on your
# Google account, then generate a 16-character App Password at:
#   https://myaccount.google.com/apppasswords
# Use that App Password here — NOT your normal Google account password.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
